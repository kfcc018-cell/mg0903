        </div>
      `,

      answers: [
        "수사기관이니 안내받은 계좌로 즉시 송금한다.",
        "일단 일부 금액만 송금해본다.",
        "전화를 종료하고 기관의 공식 연락처를 직접 찾아 사실 여부를 확인한다."
      ],

      correct: 2,

      explanation:
        "수사기관을 사칭해 자금 이전을 요구하거나 비밀 유지를 요구하는 것은 대표적인 금융사기 수법입니다.",

      signals: [
        "안전계좌 송금",
        "비밀 유지 요구",
        "기관 사칭",
        "긴급 송금"
      ]
    },

    {
      type: "메신저 피싱",

      question:
        "자녀라고 주장하는 메시지에서 급하게 돈을 보내달라고 요청합니다.",

      scenario: `
        <div class="scenario-label">
          메신저 내용
        </div>

        <div class="message-card">

          <div class="message-header">
            <span>우리 딸 ❤️</span>
            <span>오후 2:14</span>
          </div>

          <div class="message-body">
            엄마 나 휴대폰 액정 깨져서 다른 번호로 연락해ㅠㅠ<br>
            지금 급하게 결제할 게 있는데 내 인증이 안돼.<br><br>

            내가 계좌 보내줄 테니까
            90만원만 먼저 보내줄 수 있어?
          </div>

        </div>
      `,

      answers: [
        "급해 보이므로 바로 송금한다.",
        "기존에 알고 있는 자녀의 전화번호로 직접 전화해 확인한다.",
        "메시지로 주민등록번호를 물어보고 맞으면 송금한다."
      ],

      correct: 1,

      explanation:
        "가족을 사칭한 송금 요청은 기존에 알고 있던 전화번호 등 독립적인 방법으로 본인 여부를 확인해야 합니다.",

      signals: [
        "새로운 연락처",
        "긴급 송금",
        "가족 사칭"
      ]
    },

    {
      type: "대출 사기",

      question:
        "저금리 대환대출이 가능하다는 전화를 받았습니다.",

      scenario: `
        <div class="scenario-label">
          상담 내용
        </div>

        <div class="scenario-text">
          “고객님은 특별 대상자로 선정되어
          연 2%대 저금리 대출로 변경 가능합니다.

          기존 대출을 먼저 상환해야 승인되므로,
          저희 직원이 보내드리는 계좌로
          기존 대출금 일부를 입금해주세요.

          오늘까지만 가능합니다.”
        </div>
      `,

      answers: [
        "금리가 저렴하므로 안내에 따른다.",
        "승인 여부 확인을 위해 먼저 소액을 입금한다.",
        "송금하지 않고 해당 금융회사의 공식 채널을 통해 상품과 상담 내용을 다시 확인한다."
      ],

      correct: 2,

      explanation:
        "대출을 빌미로 기존 대출 상환금이나 보증금 등을 특정 계좌로 보내라고 요구한다면 금융사기를 의심해야 합니다.",

      signals: [
        "저금리 미끼",
        "선입금 요구",
        "오늘까지",
        "개인계좌 송금"
      ]
    },

    {
      type: "악성 앱 설치",

      question:
        "은행 직원이라는 사람이 보안 강화를 위해 앱 설치를 요청합니다.",

      scenario: `
        <div class="scenario-label">
          안내 내용
        </div>

        <div class="scenario-text">
          “고객님 휴대폰에 보안 문제가 발견되었습니다.

          제가 문자로 보내드리는 보안 앱을 설치하시면
          계좌 보호가 가능합니다.

          설치 후 접근 권한을 모두 허용해주세요.”
        </div>
      `,

      answers: [
        "은행 직원이므로 앱을 설치하고 모든 권한을 허용한다.",
        "앱 설치를 중단하고 해당 은행 공식 앱 또는 고객센터를 통해 확인한다.",
        "앱을 설치하되 연락처 권한만 거부한다."
      ],

      correct: 1,

      explanation:
        "문자나 메신저로 전달받은 출처 불명의 앱 설치를 피하고, 금융기관의 공식 앱과 공식 고객센터를 이용해야 합니다.",

      signals: [
        "앱 설치 요구",
        "과도한 권한",
        "원격 통제 위험"
      ]
    }

  ];

  let currentQuestion = 0;
  let score = 0;
  let correctCount = 0;
  let answered = false;

  const quizScreen =
    document.getElementById("quizScreen");

  const resultScreen =
    document.getElementById("resultScreen");

  const progressLabel =
    document.getElementById("progressLabel");

  const progressBar =
    document.getElementById("progressBar");

  const scoreDisplay =
    document.getElementById("scoreDisplay");

  const scenarioType =
    document.getElementById("scenarioType");

  const questionTitle =
    document.getElementById("questionTitle");

  const scenarioBox =
    document.getElementById("scenarioBox");

  const answers =
    document.getElementById("answers");

  const feedback =
    document.getElementById("feedback");

  const feedbackTitle =
    document.getElementById("feedbackTitle");

  const feedbackText =
    document.getElementById("feedbackText");

  const warningSignals =
    document.getElementById("warningSignals");

  const nextBtn =
    document.getElementById("nextBtn");

  function renderQuestion() {

    answered = false;

    const data =
      quizData[currentQuestion];

    progressLabel.textContent =
      `상황 ${currentQuestion + 1} / ${quizData.length}`;

    const progressPercent =
      (currentQuestion / quizData.length) * 100;

    progressBar.style.width =
      `${progressPercent}%`;

    scoreDisplay.textContent =
      `현재 점수 ${score}점`;

    scenarioType.textContent =
      data.type;

    questionTitle.textContent =
      data.question;

    scenarioBox.innerHTML =
      data.scenario;

    feedback.className =
      "feedback";

    nextBtn.classList.remove("show");

    answers.innerHTML =
      data.answers.map(
        (answer, index) => `
          <button
            class="answer-btn"
            data-index="${index}"
          >
            ${index + 1}. ${answer}
          </button>
        `
      ).join("");

    document
      .querySelectorAll(".answer-btn")
      .forEach(button => {

        button.addEventListener(
          "click",
          () => handleAnswer(button)
        );

      });

  }

  function handleAnswer(button) {

    if (answered) {
      return;
    }

    answered = true;

    const selected =
      Number(button.dataset.index);

    const data =
      quizData[currentQuestion];

    const buttons =
      document.querySelectorAll(
        ".answer-btn"
      );

    buttons.forEach(btn => {
      btn.disabled = true;
    });

    if (selected === data.correct) {

      score += 20;
      correctCount++;

      button.classList.add("correct");

      feedback.className =
        "feedback correct";

      feedbackTitle.textContent =
        "✓ 좋은 판단입니다.";

    } else {

      button.classList.add("wrong");

      buttons[data.correct]
        .classList.add("correct");

      feedback.className =
        "feedback wrong";

      feedbackTitle.textContent =
        "⚠ 조금 더 주의가 필요합니다.";

    }

    feedbackText.textContent =
      data.explanation;

    warningSignals.innerHTML =
      data.signals.map(
        signal => `
          <span class="warning-chip">
            ${signal}
          </span>
        `
      ).join("");

    scoreDisplay.textContent =
      `현재 점수 ${score}점`;

    nextBtn.classList.add("show");

    if (
      currentQuestion ===
      quizData.length - 1
    ) {

      nextBtn.textContent =
        "내 금융안전지수 확인하기";

    } else {

      nextBtn.textContent =
        "다음 상황으로";

    }

  }

  nextBtn.addEventListener(
    "click",
    () => {

      if (
        currentQuestion <
        quizData.length - 1
      ) {

        currentQuestion++;

        renderQuestion();

      } else {

        showResult();

      }

    }
  );

  function showResult() {

    quizScreen.style.display =
      "none";

    resultScreen.classList.add(
      "show"
    );

    progressBar.style.width =
      "100%";

    const wrong =
      quizData.length -
      correctCount;

    document.getElementById(
      "correctCount"
    ).textContent =
      correctCount;

    document.getElementById(
      "wrongCount"
    ).textContent =
      wrong;

    document.getElementById(
      "safePercent"
    ).textContent =
      `${score}%`;

    document.getElementById(
      "resultScore"
    ).textContent =
      `${score}점`;

    const grade =
      document.getElementById(
        "resultGrade"
      );

    const desc =
      document.getElementById(
        "resultDesc"
      );

    const icon =
      document.getElementById(
        "resultIcon"
      );

    if (score === 100) {

      grade.textContent =
        "MG 금융안전 마스터";

      icon.textContent =
        "🏆";

      desc.textContent =
        "금융사기의 대표적인 위험 신호를 매우 잘 구분하고 있습니다. 지금처럼 공식 채널을 통한 확인 습관을 유지해보세요.";

    } else if (score >= 80) {

      grade.textContent =
        "안심 대응형";

      icon.textContent =
        "🛡️";

      desc.textContent =
        "대부분의 금융사기 상황에서 안전한 판단을 할 수 있습니다. 긴급 송금이나 앱 설치 요구가 있을 때 한 번 더 확인하세요.";

    } else if (score >= 60) {

      grade.textContent =
        "주의 확인형";

      icon.textContent =
        "🔍";

      desc.textContent =
        "기본적인 위험 신호는 잘 알고 있지만 몇몇 상황에서는 추가 확인이 필요합니다. 출처가 불분명한 연락에는 즉시 행동하지 않는 습관이 중요합니다.";

    } else {

      grade.textContent =
        "금융안전 점검 필요";

      icon.textContent =
        "🚨";

      desc.textContent =
        "금융사기범은 긴급함과 불안감을 이용합니다. 송금이나 개인정보 제공 전에 반드시 공식 연락처를 통해 사실 여부를 확인해보세요.";

    }

  }

  document
    .getElementById("restartBtn")
    .addEventListener(
      "click",
      () => {

        currentQuestion = 0;
        score = 0;
        correctCount = 0;
        answered = false;

        resultScreen
          .classList.remove("show");

        quizScreen.style.display =
          "block";

        renderQuestion();

        window.scrollTo({
          top: 0,
          behavior: "smooth"
        });

      }
    );

  renderQuestion();

</script>

